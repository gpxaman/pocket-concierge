{
  "name": "pocket-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native super-app demo: a voice-first concierge that can search, compare, book, and pay across a mock ride/food/grocery/hotel catalog, plus end-to-end encrypted chat and WebRTC calling.",
  "license": "MIT",
  "author": "Aman Kumar",
  "repository": {
    "type": "git",
    "url": "https://github.com/gpxaman/pocket-concierge.git"
  },
  "homepage": "https://github.com/gpxaman/pocket-concierge#readme",
  "bugs": {
    "url": "https://github.com/gpxaman/pocket-concierge/issues"
  },
  "keywords": [
    "nextjs",
    "ai-agent",
    "voice-assistant",
    "zustand",
    "e2e-encryption",
    "webrtc",
    "demo"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "chat-server": "node server/chat-relay.mjs",
    "dev:all": "concurrently -n web,chat -c blue,magenta \"npm run dev\" \"npm run chat-server\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "^16.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
