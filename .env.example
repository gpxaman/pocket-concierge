# Optional. Without either key the AI concierge falls back to a small
# rule-based demo agent so the app still runs end-to-end with zero config.
#
# Checked in this order: GEMINI_API_KEY first, then ANTHROPIC_API_KEY.
# Get a Gemini key (free tier available) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# E2E chat relay (server/chat-relay.mjs). Optional — both default to 8787.
# Only needs to change if that port is taken, or you're reverse-proxying it.
CHAT_RELAY_PORT=8787
NEXT_PUBLIC_CHAT_RELAY_PORT=8787
